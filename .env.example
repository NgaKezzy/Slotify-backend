# ---------------------------------------------------------------------------
# Slotify backend environment. Copy to .env and adjust.
# Every value has a sensible local default in application.yml; only JWT_SECRET
# and the third-party keys are mandatory for production.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev          # dev | demo | prod
APP_BASE_URL=http://localhost:8080  # Public URL of this API
APP_WEB_URL=http://localhost:3000   # Public URL of the web front-end (verify-email / reset-password links)
CORS_ALLOWED_ORIGINS=http://localhost:3000   # Comma-separated admin panel origins

# --- Database (MySQL 8) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=slotify
DB_USER=slotify
DB_PASSWORD=slotify
DB_ROOT_PASSWORD=root               # Only used by docker-compose
DB_POOL_SIZE=10

# --- Redis (availability cache, booking locks, rate limits) ---------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Security -------------------------------------------------------------
JWT_SECRET=change-me-please-use-at-least-64-random-characters-for-hs512-signing
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_REQUIRE_EMAIL_VERIFICATION=false   # true = local accounts must verify email before login

# --- Email (SMTP). MailHog defaults for local development -----------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@slotify.local

# --- Object storage (S3 / MinIO) for images -------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=slotify
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/slotify   # Public read URL of the bucket (CDN or S3 website URL in prod)

# --- Third-party integrations (filled in later phases) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                 # sandbox | live
GOOGLE_CLIENT_ID=                   # OAuth client id(s), comma separated (web + android + ios) used to verify Google ID tokens
FIREBASE_CREDENTIALS_PATH=          # Path to the Firebase service-account JSON (push notifications)
