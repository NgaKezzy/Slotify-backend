# ---------------------------------------------------------------------------
# Slotify backend environment. Copy to .env and adjust.
# NOTE: no inline comments after values – Spring reads everything after '=' as the value.
# Every value has a sensible local default in application.yml; only JWT_SECRET
# and the third-party keys are mandatory for production.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
SERVER_PORT=8081
SEED_DEMO_DATA=true
# Log level of com.slotify (DEBUG for verbose local logs).
LOG_LEVEL=INFO
# Seeded platform-admin login (used when SEED_DEMO_DATA=true). Password is shared by every demo account.
DEMO_ADMIN_EMAIL=admin@admin.com
DEMO_ADMIN_PASSWORD=admin123
# Public URL of this API
APP_BASE_URL=http://localhost:8081
# Public URL of the web front-end (verify-email / reset-password links)
APP_WEB_URL=http://localhost:3000
# Comma-separated admin panel origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (MySQL 8) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=slotify
DB_USER=admin
DB_PASSWORD=admin123
# Only used by docker-compose
DB_ROOT_PASSWORD=admin123
# MySQL application user created by docker-compose (the API connects with DB_USER/DB_PASSWORD).
MYSQL_APP_USER=admin
MYSQL_APP_PASSWORD=admin123
DB_POOL_SIZE=10

# --- Redis (availability cache, booking locks, rate limits) ---------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Security -------------------------------------------------------------
JWT_SECRET=kPUZ52U4Fb6Q73JrSI44flIf3IUvXDGuMw2NoVbdhdLZodi2fa56nKIb7BataKhY7RkGwDV2iiOC3QBI
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# true = local accounts must verify email before login
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Email (SMTP). MailHog defaults for local development -----------------
# MailHog web UI (http://localhost:8025) login: admin / admin123 (see docker/mailhog-auth).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@slotify.local

# --- Object storage (S3 / MinIO) for images -------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=slotify
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
# Public read URL of the bucket (CDN or S3 website URL in prod)
S3_PUBLIC_BASE_URL=http://localhost:9000/slotify

# --- Third-party integrations (filled in later phases) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key returned to the mobile apps for the PaymentSheet
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal developer dashboard (used to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_MODE=sandbox
# OAuth client id(s), comma separated (web + android + ios) used to verify Google ID tokens
GOOGLE_CLIENT_ID=
# Path to the Firebase service-account JSON (push notifications)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Booking timers ---------------------------------------------------------
# Online-payment bookings not paid within this time are cancelled automatically
BOOKING_UNPAID_TIMEOUT=15m
